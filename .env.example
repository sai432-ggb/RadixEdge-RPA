# RadixEdge RPA Environment Configuration
# Copy this file to .env and fill in your values

# Application
NODE_ENV=production
PORT=3000
APP_NAME=RadixEdge RPA

# Cloud Platform (Choose one: aws, azure, gcp)
CLOUD_PLATFORM=aws
DEPLOYMENT_REGION=us-east-1

# Security
JWT_SECRET=your_jwt_secret_here
API_KEY=your_api_key_here

# Database - MongoDB
MONGODB_URI=mongodb+srv://Samarth-Laptop:2QpdxG2EVx_i4!Q@kissanbots.0wrttij.mongodb.net/?appName=KissanBots
DB_NAME=radixedge_rpa

# Database - PostgreSQL (Alternative)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_password_here

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
